{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runlit",
  "version": "0.1.0",
  "identifier": "com.runlit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../..",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:bundle --prefix ../.. && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Runlit",
        "width": 52,
        "height": 52,
        "minWidth": 52,
        "minHeight": 52,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:47831 ws://127.0.0.1:47831; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/daemon/runlit-daemon.cjs",
      "resources/runtime/node.exe",
      "resources/runtime/LICENSE-node.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
